#pragma once

#include "picongpu/particles/param.hpp"

#include <cstdint>
#include <optional>
#include <string>

namespace picongpu::neuralBunch
{
    {{#neural_bunch_enabled}}
    /* Destination species generated from the PICMI species
     * {{{neural_bunch.destination_species_name}}}. The ``PIC_`` alias keeps the
     * user-facing spelling while the generated C++ type stays
     * ``{{{neural_bunch.destination_species}}}``. */
    using PIC_{{neural_bunch.destination_species_name}} = {{neural_bunch.destination_species}};
    using Species = PIC_{{neural_bunch.destination_species_name}};

    /* Cell geometry derived from the PICMI grid (metres): dx={{{neural_bunch.cell_size_si.x}}},
     * dy={{{neural_bunch.cell_size_si.y}}}, dz={{{neural_bunch.cell_size_si.z}}}. */
    struct NeuralBunchParam
    {
        /* PICMI configured picongpu_neural_bunch, so the stage runs. */
        bool enabled = true;
        std::string filename = "{{{neural_bunch.filename}}}";
        std::uint64_t iteration = {{{neural_bunch.iteration}}};
        std::string species = "{{{neural_bunch.source_species}}}";
        std::string modelPath = "{{{neural_bunch.modelPath}}}";
        std::uint64_t chunkSize = {{{neural_bunch.chunkSize}}};
        std::uint32_t tileBatch = {{{neural_bunch.tileBatch}}};
        bool enableReferenceFallback = {{#neural_bunch.enableReferenceFallback}}true{{/neural_bunch.enableReferenceFallback}}{{^neural_bunch.enableReferenceFallback}}false{{/neural_bunch.enableReferenceFallback}};

        enum class FieldInitializer
        {
            neural,
            validatedNeural,
            referenceOnly,
            banded
        };
        std::optional<FieldInitializer> fieldInitializer = FieldInitializer::{{{neural_bunch.fieldInitializer}}};
        double bandedNearMaxCells = 4.0;
        double bandedFarMinCells = 48.0;
        bool useModelForNear = false;
        std::optional<bool> useModelForMid{};
        bool useMidCorrection = false;
        bool useExactDevice = false;
        double bandedExactMaxCells = 128.0;
        double bandedExactAspect10Cells = 512.0;
        bool tileWideField = true;
        bool tileWideBandStats = true;
        int timePolicy = {{{neural_bunch.timePolicy}}};
    };
    {{/neural_bunch_enabled}}
    {{^neural_bunch_enabled}}
    /* No neural bunch initializer was requested by the PICMI simulation. This
     * placeholder keeps ``neuralBunch.param`` syntactically valid when
     * PIC_USE_neuralBunch is compiled in, and leaves the stage disabled. */
    using Species = {{neural_bunch_fallback_species}};

    struct NeuralBunchParam
    {
        /* No picongpu_neural_bunch was configured; keep the stage disabled so a
         * standard simulation behaves exactly as before. */
        bool enabled = false;
        std::string filename = "";
        std::uint64_t iteration = 0;
        std::string species = "e";
        std::string modelPath = "";
        std::uint64_t chunkSize = 1048576;
        std::uint32_t tileBatch = 1;
        bool enableReferenceFallback = true;

        enum class FieldInitializer
        {
            neural,
            validatedNeural,
            referenceOnly,
            banded
        };
        std::optional<FieldInitializer> fieldInitializer{};
        double bandedNearMaxCells = 4.0;
        double bandedFarMinCells = 48.0;
        bool useModelForNear = false;
        std::optional<bool> useModelForMid{};
        bool useMidCorrection = false;
        bool useExactDevice = false;
        double bandedExactMaxCells = 128.0;
        double bandedExactAspect10Cells = 512.0;
        bool tileWideField = true;
        bool tileWideBandStats = true;
        int timePolicy = 0;
    };
    {{/neural_bunch_enabled}}

    inline NeuralBunchParam const neuralBunchParam{};
} // namespace picongpu::neuralBunch

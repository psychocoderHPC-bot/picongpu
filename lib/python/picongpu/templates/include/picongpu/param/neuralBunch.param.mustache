#pragma once

#include "picongpu/particles/param.hpp"

#include <cstdint>
#include <string>

namespace picongpu::neuralBunch
{
    {{#neural_bunch}}
    /* Destination species generated from the PICMI species
     * {{{destination_species_name}}}. The ``PIC_`` alias keeps the
     * user-facing spelling while the generated C++ type stays
     * ``{{{destination_species}}}``. */
    using PIC_{{destination_species_name}} = {{destination_species}};
    using Species = PIC_{{destination_species_name}};

    /* Cell geometry derived from the PICMI grid (metres): dx={{{cell_size_si.x}}},
     * dy={{{cell_size_si.y}}}, dz={{{cell_size_si.z}}}. */
    struct NeuralBunchParam
    {
        std::string filename = "{{{filename}}}";
        std::uint64_t iteration = {{{iteration}}};
        std::string species = "{{{source_species}}}";
        std::string modelPath = "{{{modelPath}}}";
        std::uint64_t chunkSize = {{{chunkSize}}};
        std::uint32_t tileBatch = {{{tileBatch}}};
        bool enableReferenceFallback = {{#enableReferenceFallback}}true{{/enableReferenceFallback}}{{^enableReferenceFallback}}false{{/enableReferenceFallback}};

        enum class FieldInitializer
        {
            neural,
            validatedNeural,
            referenceOnly
        };
        FieldInitializer fieldInitializer = FieldInitializer::{{{fieldInitializer}}};
        int timePolicy = {{{timePolicy}}};
    };
    {{/neural_bunch}}
    {{^neural_bunch}}
    /* No neural bunch initializer was requested by the PICMI simulation. This
     * placeholder keeps ``neuralBunch.param`` syntactically valid when
     * PIC_USE_neuralBunch is compiled in. It is reference-only with an empty
     * source path, so a simulation that actually runs the stage must configure
     * picongpu_neural_bunch. */
    using Species = {{neural_bunch_fallback_species}};

    struct NeuralBunchParam
    {
        std::string filename = "";
        std::uint64_t iteration = 0;
        std::string species = "e";
        std::string modelPath = "";
        std::uint64_t chunkSize = 1048576;
        std::uint32_t tileBatch = 1;
        bool enableReferenceFallback = true;

        enum class FieldInitializer
        {
            neural,
            validatedNeural,
            referenceOnly
        };
        FieldInitializer fieldInitializer = FieldInitializer::referenceOnly;
        int timePolicy = 0;
    };
    {{/neural_bunch}}

    inline NeuralBunchParam const neuralBunchParam{};
} // namespace picongpu::neuralBunch
